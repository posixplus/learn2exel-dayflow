# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# MOCK=1 runs Dayflow against fixtures/ with no Google access. MOCK=0 uses real Gmail and Calendar (lesson 87).
MOCK=1
DAYFLOW_MODEL=claude-sonnet-5-5
# Where runs and tasks are stored (lesson 83). Relative to the working directory.
DAYFLOW_DB=dayflow.db
# Lesson 84: pin the agent's idea of today (YYYY-MM-DD). Defaults to the fixture Monday under MOCK=1.
# DAYFLOW_TODAY=2026-09-07
# Lesson 85: specialists (inbox/calendar/tasks readers) run on a small model; the synthesiser uses DAYFLOW_MODEL.
# DAYFLOW_SPECIALIST_MODEL=claude-haiku-5-5
# DAYFLOW_INBOX=large   # 120-message fixture inbox
# Lesson 86: how long a queued write proposal stays approvable.
# DAYFLOW_APPROVAL_TTL_HOURS=24
# Lesson 87: OAuth client (type: Desktop app) from Google Cloud Console. See README, "Real Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DAYFLOW_TOKEN_PATH=~/.config/dayflow/google_token.json
# How much real mail one run reads: newest N, body characters each, and the Gmail search.
# DAYFLOW_INBOX_MAX=30
# DAYFLOW_BODY_CHARS=400
# DAYFLOW_INBOX_QUERY=in:inbox newer_than:3d -category:promotions -category:social
